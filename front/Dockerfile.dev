FROM node:22-alpine

WORKDIR /app

# Copié séparément du reste du code pour profiter du cache Docker :
# tant que package.json/package-lock.json ne changent pas, cette étape n'est pas rejouée
COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]